<service>
  <id>jasper-report-service</id>
  <name>Jasper Report Service</name>
  <description>Spring Boot service that compiles and renders JasperReports .jrxml files to PDF.</description>

  <!-- If "java" isn't on PATH for the account running the service (e.g. LocalSystem),
       replace this with the full path, e.g. C:\Program Files\Java\jdk-21\bin\java.exe -->
  <executable>java</executable>
  <arguments>-jar "%BASE%\jasper-report-service.jar"</arguments>

  <!-- The API listens on port 8080 unless config\service.properties sets
       server.port. To set it here instead, pass it as a system property in
       the arguments above, before -jar, e.g.
       -Dserver.port=9090 -jar "%BASE%\jasper-report-service.jar" -->

  <!-- %BASE% = the directory this xml/exe live in. application.properties reads
       reports.directory, config/db.properties and config/service.properties
       relative to this working directory. -->
  <workingdirectory>%BASE%</workingdirectory>

  <!-- Rolls at midnight, and sooner if the current file passes 10 MB.
       Rolled files are named jasper-report-service.out.yyyyMMdd.log and
       zipped once they are older than 30 days. -->
  <log mode="roll-by-size-time">
    <logpath>%BASE%\logs</logpath>
    <sizeThreshold>10240</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <zipOlderThanNumDays>30</zipOlderThanNumDays>
  </log>

  <onfailure action="restart" delay="10 sec"/>
  <startmode>Automatic</startmode>
  <stopparentprocessfirst>true</stopparentprocessfirst>
</service>
