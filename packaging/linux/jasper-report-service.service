# systemd unit for the Jasper Report Service.
#
# install-service.sh copies this to /etc/systemd/system/ and substitutes
# __INSTALL_DIR__, __SERVICE_USER__ and __JAVA__. Edit it there afterwards
# (then: systemctl daemon-reload && systemctl restart jasper-report-service).
[Unit]
Description=Jasper Report Service
Documentation=https://github.com/Synergy-Tooling-Systems/jasperServer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__

# The application resolves reports.directory, config/db.properties and
# config/service.properties relative to its working directory, so this must be
# the directory holding the jar.
WorkingDirectory=__INSTALL_DIR__
ExecStart=__JAVA__ -jar __INSTALL_DIR__/jasper-report-service.jar

# Spring Boot exits with 143 (128 + SIGTERM) on a clean systemd stop.
SuccessExitStatus=143

Restart=on-failure
RestartSec=10
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=jasper-report-service

# The service only needs to read its own directory and reach the database.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
